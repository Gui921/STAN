    "\n",
    "            # Forward pass\n",
    "            logits, _, _ = model(videos)\n",
    "\n",
    "            # Compute the loss\n",
    "            loss = criterion(logits, labels)\n",
    "\n",
    "            # Track loss and accuracy\n",
    "            val_loss += loss.item()\n",
    "            val_accuracy += accuracy_metric(logits, labels)\n",
